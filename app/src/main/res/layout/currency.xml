<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="Currency Converter"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Tiền tệ nguồn -->
    <TextView
        android:text="From:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Spinner
        android:id="@+id/spinnerFrom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/editFrom"
        android:inputType="none"
        android:focusable="false"
        android:textSize="20sp"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Tiền tệ đích -->
    <TextView
        android:text="To:"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <Spinner
        android:id="@+id/spinnerTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/editTo"
        android:inputType="none"
        android:focusable="false"
        android:textSize="20sp"
        android:layout_marginVertical="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Bàn phím số -->
    <GridLayout
        android:id="@+id/keypad"
        android:layout_marginTop="12dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Hàng 1 -->
        <Button android:text="7" style="@style/KeyButton"/>
        <Button android:text="8" style="@style/KeyButton"/>
        <Button android:text="9" style="@style/KeyButton"/>

        <!-- Hàng 2 -->
        <Button android:text="4" style="@style/KeyButton"/>
        <Button android:text="5" style="@style/KeyButton"/>
        <Button android:text="6" style="@style/KeyButton"/>

        <!-- Hàng 3 -->
        <Button android:text="1" style="@style/KeyButton"/>
        <Button android:text="2" style="@style/KeyButton"/>
        <Button android:text="3" style="@style/KeyButton"/>

        <!-- Hàng 4 -->
        <Button android:text="0" style="@style/KeyButton"/>
        <Button android:text="." style="@style/KeyButton"/>
        <Button android:text="⌫" style="@style/KeyButton"/>

    </GridLayout>

    <Button
        android:id="@+id/btnClear"
        android:text="CE"
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>
